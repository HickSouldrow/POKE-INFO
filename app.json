{
  "expo": {
    "name": "Pokeinfo",
    "slug": "Pokeinfo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Pokeball.png",
    "scheme": "Pokeinfo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Pokeball.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://lnh1dhp1mj.execute-api.us-east-1.amazonaws.com/api-pokemon"
    }
  }
}
