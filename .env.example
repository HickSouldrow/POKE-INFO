# URL do backend de autenticação/dados.
# Padrão: o API Gateway do projeto na AWS.
# Para usar o backend Spring do projeto de login rodando na máquina:
#   EXPO_PUBLIC_API_URL=http://localhost:8081/fatec/login
# Testando no celular físico, troque localhost pelo IP da sua máquina na rede.
EXPO_PUBLIC_API_URL=https://lnh1dhp1mj.execute-api.us-east-1.amazonaws.com/api-pokemon

# Validade dos tokens temporários, em segundos (opcional).
EXPO_PUBLIC_ACCESS_TTL=300
EXPO_PUBLIC_REFRESH_TTL=28800
